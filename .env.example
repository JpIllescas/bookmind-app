# Lo lee scripts/generate-environment.mjs para generar environment.generated.ts.
# Solo valores públicos: terminan en el bundle del navegador.

# Base de la API. Por defecto http://localhost:3000/api.
API_URL = http://localhost:3000/api

# Mismo client ID que el backend. El secret NO va aquí.
GOOGLE_CLIENT_ID = <id>.apps.googleusercontent.com
